<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>reactive-vcr third-party licenses</title>
<style>
body{max-width:900px;margin:40px auto;padding:0 20px;color:#222;font:15px/1.55 system-ui,sans-serif}h1,h2{line-height:1.15}h2{margin-top:48px}pre{overflow:auto;padding:18px;background:#f4f4f4;white-space:pre-wrap}a{color:#075e54}
</style>
<h1>reactive-vcr third-party licenses</h1>
<p>This document lists licenses selected for runtime dependencies in the locked Cargo graph.</p>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}} crates)</li>
{{/each}}
</ul>
{{#each licenses}}
<section id="{{id}}">
  <h2>{{name}}</h2>
  <p>Used by:</p>
  <ul>
  {{#each used_by}}
    <li><a href="{{crate.repository}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</html>
